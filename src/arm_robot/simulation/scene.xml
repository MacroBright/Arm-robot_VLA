<mujoco model="zero_arm_massage">
  <compiler angle="radian" meshdir="meshes" />

  <!-- ============================================================
       Zero Arm VLA — MuJoCo 仿真模型
       基于 zero-robotic-arm SolidWorks 导出 + 固件参数校准
       关节限位来源: firmware/src/robot.c g_joints_init[]
       DH 参数来源: firmware/src/robot.c D_H[6][4]
       复位姿态来源: firmware/src/robot.c soft_reset
       ============================================================ -->

  <default>
    <default class="robot">
      <default class="motor">
        <joint damping="2.0"/>
        <motor forcerange="-20 20"/>
      </default>
      <default class="visual">
        <geom material="visualgeom" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom material="collision_material" condim="3" contype="0" conaffinity="1"
              priority="1" group="1" solref="0.005 1" friction="1 0.01 0.01"/>
        <equality solimp="0.99 0.999 1e-05" solref="0.005 1"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="defalut_visual" rgba="0.75 0.75 0.75 1"/>
    <material name="default_material" rgba="0.7 0.7 0.7 1"/>
    <material name="collision_material" rgba="1.0 0.28 0.1 0.9"/>
    <mesh name="base_link.STL" file="base_link.STL"/>
    <mesh name="link1.STL" file="link1.STL"/>
    <mesh name="link2.STL" file="link2.STL"/>
    <mesh name="link3.STL" file="link3.STL"/>
    <mesh name="link4.STL" file="link4.STL"/>
    <mesh name="link5.STL" file="link5.STL"/>
    <mesh name="ee_link.STL" file="ee_link.STL"/>
    <texture name="plane" type="2d" builtin="checker" rgb1=".1 .1 .1" rgb2=".9 .9 .9"
             width="64" height="64" mark="cross" markrgb=".8 .8 .8"/>
    <material name="plane" reflectance="0.3" texture="plane" texrepeat="4 4" texuniform="true"/>
  </asset>

  <worldbody>
    <geom name="floor" pos="0 0 0" size="0 0 .25" type="plane" material="plane" condim="3"/>
    <light directional="true" ambient=".3 .3 .3" pos="30 30 30" dir="0 -.5 -1"
           diffuse=".5 .5 .5" specular=".5 .5 .5"/>

    <!-- ── 机械臂层级结构 ── -->
    <body name="base_link" pos="0 0 0" quat="1 0 0 0" childclass="robot">
      <geom name="base_link_collision" pos="0 0 0" quat="1 0 0 0"
            type="mesh" mesh="base_link.STL" class="collision"/>
      <geom name="base_link_visual" pos="0 0 0" quat="1 0 0 0"
            type="mesh" mesh="base_link.STL" class="visual"
            material="defalut_visual"/>

      <!-- Joint 1: shoulder_pan (底座旋转), 无限旋转 -->
      <body name="link1" pos="0 0 0.166" quat="0.707105 0 0 0.707108">
        <joint name="joint1" type="hinge" class="motor"
               axis="0 0 1"/>
        <inertial pos="0.000159 -0.024341 -0.017707" quat="1 0 0 0"
                  mass="0.060847"
                  diaginertia="3.70074e-05 2.56789e-05 3.87763e-05"/>
        <geom name="link1_collision" pos="0 0 0" quat="1 0 0 0"
              type="mesh" mesh="link1.STL" class="collision"/>
        <geom name="link1_visual" pos="0 0 0" quat="1 0 0 0"
              type="mesh" mesh="link1.STL" class="visual"
              material="defalut_visual"/>

        <!-- Joint 2: shoulder_lift (肩部抬升), 90-180° -->
        <body name="link2" pos="0 0 0"
              quat="0.499998 0.500000 -0.500000 0.500002">
          <joint name="joint2" type="hinge" class="motor"
                 axis="0 0 1" range="-1.5708 2.3562"/>
          <inertial pos="0.100017 0.000107 -0.010784" quat="1 0 0 0"
                    mass="0.433546"
                    diaginertia="0.00014043 0.00105046 0.00104173"/>
          <geom name="link2_collision" pos="0 0 0" quat="1 0 0 0"
                type="mesh" mesh="link2.STL" class="collision"/>
          <geom name="link2_visual" pos="0 0 0" quat="1 0 0 0"
                type="mesh" mesh="link2.STL" class="visual"
                material="defalut_visual"/>

          <!-- Joint 3: elbow_flex (肘部), -90-90° -->
          <body name="link3" pos="0.2 0 0"
                quat="-2.597e-06 -0.707105 -0.707108 -2.597e-06">
            <joint name="joint3" type="hinge" class="motor"
                   axis="0 0 1" range="0 2.3562"/>
            <inertial pos="0.041317 -0.047993 -0.010945" quat="1 0 0 0"
                      mass="0.163444"
                      diaginertia="0.00013214 7.61011e-05 0.00013352"/>
            <geom name="link3_collision" pos="0 0 0" quat="1 0 0 0"
                  type="mesh" mesh="link3.STL" class="collision"/>
            <geom name="link3_visual" pos="0 0 0" quat="1 0 0 0"
                  type="mesh" mesh="link3.STL" class="visual"
                  material="defalut_visual"/>

            <!-- 腕心: J4 旋转轴点, 位置环反馈用 (J4/J5/J6 旋转不移动它) -->
            <site name="wrist_site" pos="0.047631 -0.1845 0" size="0.005"/>

            <!-- Joint 4: wrist_flex (腕部俯仰), -90-90° -->
            <body name="link4" pos="0.047631 -0.1845 0"
                  quat="0.707105 -0.707108 0 0">
              <joint name="joint4" type="hinge" class="motor"
                     axis="0 0 1" range="-3.1416 3.1416"
                     damping="15.0"/>
              <inertial pos="-2.816e-05 -0.006828 0.029946" quat="1 0 0 0"
                        mass="0.178466"
                        diaginertia="0.00010542 0.00011129 4.42311e-05"/>
              <geom name="link4_collision" pos="0 0 0" quat="1 0 0 0"
                    type="mesh" mesh="link4.STL" class="collision"/>
              <geom name="link4_visual" pos="0 0 0" quat="1 0 0 0"
                    type="mesh" mesh="link4.STL" class="visual"
                    material="defalut_visual"/>

              <!-- Joint 5: wrist_roll (腕部旋转), 0-90° -->
              <body name="link5" pos="0 0 0"
                    quat="0.499998 0.500000 -0.500000 0.500002">
                <joint name="joint5" type="hinge" class="motor"
                       axis="0 0 1" range="-3.1416 3.1416"/>
                <inertial pos="0.000156 -0.061792 -0.010025" quat="1 0 0 0"
                          mass="0.157932"
                          diaginertia="0.00013593 5.60083e-05 0.00012146"/>
                <geom name="link5_collision" pos="0 0 0" quat="1 0 0 0"
                      type="mesh" mesh="link5.STL" class="collision"/>
                <geom name="link5_visual" pos="0 0 0" quat="1 0 0 0"
                      type="mesh" mesh="link5.STL" class="visual"
                      material="defalut_visual"/>

                <!-- Joint 6: gripper (末端/夹爪), 0-360° -->
                <body name="ee_link" pos="0 -0.125 0"
                      quat="0.707105 0.707108 0 0">
                  <joint name="joint6" type="hinge" class="motor"
                         axis="0 0 1" range="0 6.2832"/>
                  <inertial pos="0 5.067e-17 -0.008107" quat="1 0 0 0"
                            mass="0.008816"
                            diaginertia="6.529e-07 6.529e-07 9.307e-07"/>
                  <geom name="ee_link_collision" pos="0 0 0" quat="1 0 0 0"
                        type="mesh" mesh="ee_link.STL" class="collision"/>
                  <geom name="ee_link_visual" pos="0 0 0" quat="1 0 0 0"
                        type="mesh" mesh="ee_link.STL" class="visual"
                        material="defalut_visual"/>
                  <!-- 末端关节中心相机: 关节原点后5cm, 视线沿 +Z, 顺时90° -->
                  <camera name="ee_camera" pos="0 0 0.02"
                          quat="0 0.707 0.707 0"
                          fovy="60" resolution="640 480"/>
                  <!-- 末端传感器点 -->
                  <site name="ee_site" pos="0 0 0"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ── 全局传感器点 ── -->
      <site name="base_link_site" pos="0 0 0" quat="1 0 0 0"/>

      <!-- ── 相机 ── -->
      <!-- 数据录制用俯视相机 (高位俯拍, 向下看) -->
      <camera name="cam_top" pos="0.2 0 0.85" xyaxes="1 0 0 0 1 0"
              fovy="80" resolution="640 480"/>
      <!-- 交互式 viewer 跟踪相机 -->
      <camera name="front_camera" mode="track" fovy="90"
              quat="4.33e-17 4.33e-17 0.707107 0.707107"
              pos="0 1.5 0.5"/>
      <camera name="side_camera" mode="track" fovy="90"
              quat="-0.5 -0.5 0.5 0.5"
              pos="-1.5 0 0.5"/>
    </body>

    <!-- ── 目标小球: mocap 运动学刚体, 受代码控制不坠 ──
         通过 target_reset / target_set 命令控制位置
         mocap_pos / mocap_quat 控制位姿 -->
    <body name="target_ball" mocap="true" pos="0.2 0.15 0.25">
      <geom name="target_geom" type="sphere" size="0.015"
            rgba="1.0 0.25 0.25 1.0"
            contype="1" conaffinity="1"/>
    </body>

  </worldbody>

  <!-- ── 电机力矩限幅 — 匹配真实 Emm_V5 规格 (Nm) ──
       J1-J4,J6: NEMA17 0.45Nm × 50:1 ≈ 22.5Nm → ±20
       J5:       NEMA14 0.18Nm × 26.85:1 ≈ 4.8Nm → ±4      -->
  <actuator>
    <motor name="joint1_ctrl" joint="joint1" class="motor"
           ctrlrange="-20 20"/>
    <motor name="joint2_ctrl" joint="joint2" class="motor"
           ctrlrange="-20 20"/>
    <motor name="joint3_ctrl" joint="joint3" class="motor"
           ctrlrange="-20 20"/>
    <motor name="joint4_ctrl" joint="joint4" class="motor"
           ctrlrange="-20 20"/>
    <motor name="joint5_ctrl" joint="joint5" class="motor"
           ctrlrange="-4 4"/>
    <motor name="joint6_ctrl" joint="joint6" class="motor"
           ctrlrange="-20 20"/>
  </actuator>

  <!-- ── 邻接 body 间不产生碰撞 ── -->
  <contact>
    <exclude body1="base_link" body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="ee_link"/>
  </contact>

  <!-- ── 传感器 ── -->
  <sensor>
    <framepos name="base_link_site_pos" objtype="site" objname="base_link_site"/>
    <framequat name="base_link_site_quat" objtype="site" objname="base_link_site"/>
    <framelinvel name="base_link_site_linvel" objtype="site" objname="base_link_site"/>
    <frameangvel name="base_link_site_angvel" objtype="site" objname="base_link_site"/>
    <velocimeter name="base_link_site_vel" site="base_link_site"/>
    <framepos name="ee_site_pos" objtype="site" objname="ee_site"/>
    <framelinvel name="ee_site_linvel" objtype="site" objname="ee_site"/>
    <frameangvel name="ee_site_angvel" objtype="site" objname="ee_site"/>
    <velocimeter name="ee_site_vel" site="ee_site"/>
  </sensor>

  <!-- ── 初始姿态: 各关节中位值, 避开限位边界 ──
       J1=90 J2=45 J3=90 J4=90 J5=0 J6=0 (度) -->
  <keyframe>
    <key name="soft_reset"
         qpos="1.5708 0.7854 1.5708 1.5708 0 0"
         ctrl="1.5708 0.7854 1.5708 1.5708 0 0"/>
  </keyframe>
</mujoco>
